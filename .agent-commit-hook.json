{
  "memory_dir": "~/.codex/memories/projects/github-stars",
  "repo_report_dir": ".agent/commit-reports",
  "include_globs": [
    "README.md",
    "fetch-stars-1.py",
    ".agent-commit-hook.json",
    ".githooks/*",
    "tools/*.py"
  ],
  "exclude_globs": [
    ".git/**",
    "__pycache__/**",
    ".agent/**",
    "github_starred_repos.csv",
    "*.pyc"
  ],
  "session_globs": [
    ".agent/session-notes/*.md",
    ".agent/session-notes/*.txt"
  ],
  "log_globs": [
    ".agent/logs/*.log",
    ".agent/logs/*.txt",
    ".agent/logs/*.jsonl"
  ],
  "max_file_bytes": 120000,
  "max_log_bytes": 120000,
  "capture_repo_snapshot": true,
  "capture_sessions": true,
  "capture_logs": true,
  "capture_git_config": true,
  "capture_environment": true,
  "capture_gh_status": true
}
